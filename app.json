{
	"expo": {
		"name": "life-managment-app",
		"slug": "life-managment-app",
		"version": "1.0.0",
		"orientation": "portrait",
		"scheme": "lifemanagmentapp",
		"userInterfaceStyle": "automatic",
		"newArchEnabled": true,
		"ios": {
			"supportsTablet": true
		},
		"android": {
			"edgeToEdgeEnabled": true,
			"predictiveBackGestureEnabled": false
		},
		"web": {},
		"plugins": [
			[
				"expo-splash-screen",
				{
					"resizeMode": "contain",
					"backgroundColor": "#ffffff",
					"dark": {
						"backgroundColor": "#000000"
					}
				}
			]
		],
		"experiments": {
			"reactCompiler": true
		}
	}
}
